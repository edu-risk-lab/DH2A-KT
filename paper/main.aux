\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Tier~2 explanation faithfulness: grounded Diagnostician vs.\ independent generation (IG). ID-anchored KC-Jaccard (JC) measures overlap between \texttt  {GroundedKCs} trailer IDs and the support set $\{\mathrm  {target}\}\cup \mathrm  {history}\cup 1$-hop $E_{\mathrm  {pre}}$. IG omits frozen $P(\mathrm  {correct})$ from the Diagnostician prompt; the Critic still sees the true Tier-1 score. The original Ollama pack used the v2 graph-only checkpoint (also the human-rating pack). The recommended Q$\leftarrow $KC$+\Delta t$ tracer is a same-prompt re-run ($n{=}500$).}}{22}{table.9}\protected@file@percent }
\newlabel{tab:kc-jaccard-ig}{{9}{22}{Tier~2 explanation faithfulness: grounded Diagnostician vs.\ independent generation (IG). ID-anchored KC-Jaccard (JC) measures overlap between \texttt {GroundedKCs} trailer IDs and the support set $\{\mathrm {target}\}\cup \mathrm {history}\cup 1$-hop $E_{\mathrm {pre}}$. IG omits frozen $P(\mathrm {correct})$ from the Diagnostician prompt; the Critic still sees the true Tier-1 score. The original Ollama pack used the v2 graph-only checkpoint (also the human-rating pack). The recommended Q$\leftarrow $KC$+\Delta t$ tracer is a same-prompt re-run ($n{=}500$)}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Human rating of Tier~2 outputs (XES3G5M fold~0 Ollama v2 pilot subsample, $n{=}40$ explanations, 2 independent raters, Likert 1--5). Agreement is pairwise Spearman $\rho $ and fraction of scores within $\pm 1$.}}{22}{table.10}\protected@file@percent }
\newlabel{tab:human-eval}{{10}{22}{Human rating of Tier~2 outputs (XES3G5M fold~0 Ollama v2 pilot subsample, $n{=}40$ explanations, 2 independent raters, Likert 1--5). Agreement is pairwise Spearman $\rho $ and fraction of scores within $\pm 1$}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces FoundationalASSIST secondary corpus (fold~0). Session hyperedges use a 30-minute gap; Hint members appear when \texttt  {hint\_count}$>0$. Predictive AUC is observational (no P0-reused GKT/simpleKT column). Hint ATE is IPW of \texttt  {hint\_used}$_t$ on \texttt  {correct}$_{t+1}$ under pre-$t$ confounders; propensity mass hits the clip floor --- treat as limited observational evidence.}}{24}{table.11}\protected@file@percent }
\newlabel{tab:foundational-assist}{{11}{24}{FoundationalASSIST secondary corpus (fold~0). Session hyperedges use a 30-minute gap; Hint members appear when \texttt {hint\_count}$>0$. Predictive AUC is observational (no P0-reused GKT/simpleKT column). Hint ATE is IPW of \texttt {hint\_used}$_t$ on \texttt {correct}$_{t+1}$ under pre-$t$ confounders; propensity mass hits the clip floor --- treat as limited observational evidence}{table.11}{}}
