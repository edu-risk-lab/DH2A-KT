\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Test-only AUC on XES3G5M fold~0 under the \emph  {clean} protocol (mask-repeats, chunked windows, $L{=}400$). DH$^2$ rows use native scoring ($n{=}1{,}093{,}755$). pyKT baselines use the library intersection ($n{=}1{,}093{,}720$; occurrence join in Section~\ref {sec:clean-protocol}). Values are mean $\pm $ sample SD over five training seeds (42, 17, 1234, 0, 2024) of the \emph  {same} test-only metric. QKC-T seed~42 is $0.829593$ and matches Table~\ref {tab:calibration-xes3g5m}. The archived A2 combined val+test mean $0.8296{\pm }0.0001$ ($n{=}1{,}640{,}242$) is \emph  {not} this column. Zero$+\Delta t$ is the credited-minimal control (Table~\ref {tab:qkc-zero-time}); QKC-T is the observed-incidence evaluation arm for GIKT-family parity. Unrounded five-seed means agree to five decimals (QKC-T $0.829492$; Zero$+\Delta t$ $0.829486$). GIKT is matched to the DH$^2$ \emph  {training envelope} (batch 16, cap 30 epochs, patience 5), not to a hyperparameter search (\ref {app:hparams}). Five-seed mean gaps from unrounded test-only means: QKC-T (or Zero$+\Delta t$) minus GIKT ${+}0.0036$, minus AKT ${+}0.0072$, minus \textit  {simpleKT} ${+}0.0081$ (printed cells subtract to the same hundredths). History-only $\Delta t$ and the capacity-mismatched pathway-off twin are not in this table (Table~\ref {tab:a7-query-dt}; Section~\ref {sec:credit-gate}). This is \emph  {not} the three-fold graph-only v2 table (\ref {app:graph-only}).}}{28}{table.6}\protected@file@percent }
\newlabel{tab:auc-xes3g5m}{{6}{28}{Test-only AUC on XES3G5M fold~0 under the \emph {clean} protocol (mask-repeats, chunked windows, $L{=}400$). DH$^2$ rows use native scoring ($n{=}1{,}093{,}755$). pyKT baselines use the library intersection ($n{=}1{,}093{,}720$; occurrence join in Section~\ref {sec:clean-protocol}). Values are mean $\pm $ sample SD over five training seeds (42, 17, 1234, 0, 2024) of the \emph {same} test-only metric. QKC-T seed~42 is $0.829593$ and matches Table~\ref {tab:calibration-xes3g5m}. The archived A2 combined val+test mean $0.8296{\pm }0.0001$ ($n{=}1{,}640{,}242$) is \emph {not} this column. Zero$+\Delta t$ is the credited-minimal control (Table~\ref {tab:qkc-zero-time}); QKC-T is the observed-incidence evaluation arm for GIKT-family parity. Unrounded five-seed means agree to five decimals (QKC-T $0.829492$; Zero$+\Delta t$ $0.829486$). GIKT is matched to the DH$^2$ \emph {training envelope} (batch 16, cap 30 epochs, patience 5), not to a hyperparameter search (\ref {app:hparams}). Five-seed mean gaps from unrounded test-only means: QKC-T (or Zero$+\Delta t$) minus GIKT ${+}0.0036$, minus AKT ${+}0.0072$, minus \textit {simpleKT} ${+}0.0081$ (printed cells subtract to the same hundredths). History-only $\Delta t$ and the capacity-mismatched pathway-off twin are not in this table (Table~\ref {tab:a7-query-dt}; Section~\ref {sec:credit-gate}). This is \emph {not} the three-fold graph-only v2 table (\ref {app:graph-only})}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Capacity-matched Q$\leftarrow $KC attribution on XES3G5M fold~0 (clean protocol). Both arms keep \texttt  {--question-graph} (same \texttt  {question\_embed}, GCN linear, and input projection); only the train-only incidence matrix is replaced by zeros in the twin (\texttt  {--question-incidence-control zero}). Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$. Checkpoint state shapes match on every seed; observed nonzero links $=8848$, zero arm $=0$. Mean $\Delta \mathrm  {val}{=}{-}0.00010{\pm }0.00034$; mean $\Delta \mathrm  {test\text  {-}only}{\approx }{+}0.00004$. $0/5$ seeds pass: the incidence \emph  {message} is not credited. The older hard-off twin that removed the whole question pathway is not used for this claim (Section~\ref {sec:credit-gate}). $\Delta $test columns are outer test-only AUC (1{,}093{,}755 scored positions).}}{29}{table.7}\protected@file@percent }
\newlabel{tab:qkc-capacity}{{7}{29}{Capacity-matched Q$\leftarrow $KC attribution on XES3G5M fold~0 (clean protocol). Both arms keep \texttt {--question-graph} (same \texttt {question\_embed}, GCN linear, and input projection); only the train-only incidence matrix is replaced by zeros in the twin (\texttt {--question-incidence-control zero}). Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$. Checkpoint state shapes match on every seed; observed nonzero links $=8848$, zero arm $=0$. Mean $\Delta \mathrm {val}{=}{-}0.00010{\pm }0.00034$; mean $\Delta \mathrm {test\text {-}only}{\approx }{+}0.00004$. $0/5$ seeds pass: the incidence \emph {message} is not credited. The older hard-off twin that removed the whole question pathway is not used for this claim (Section~\ref {sec:credit-gate}). $\Delta $test columns are outer test-only AUC (1{,}093{,}755 scored positions)}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Linear $\Delta t$ on the capacity-matched \emph  {zero-incidence} backbone (XES3G5M fold~0, clean protocol). Both arms keep zero Q--KC incidence; \texttt  {zero\_time} adds LSTM+query $\log (1{+}\Delta t)$ (\texttt  {--time-gap-mode both}). Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$. Mean $\Delta \mathrm  {val}{=}{+}0.00255{\pm }0.00015$; mean $\Delta \mathrm  {test\text  {-}only}{=}{+}0.00269{\pm }0.00012$. $5/5$ seeds pass: the \emph  {branch} credit is not an artefact of nonzero incidence. State shapes differ by the timing parameters (expected).}}{29}{table.8}\protected@file@percent }
\newlabel{tab:qkc-zero-time}{{8}{29}{Linear $\Delta t$ on the capacity-matched \emph {zero-incidence} backbone (XES3G5M fold~0, clean protocol). Both arms keep zero Q--KC incidence; \texttt {zero\_time} adds LSTM+query $\log (1{+}\Delta t)$ (\texttt {--time-gap-mode both}). Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$. Mean $\Delta \mathrm {val}{=}{+}0.00255{\pm }0.00015$; mean $\Delta \mathrm {test\text {-}only}{=}{+}0.00269{\pm }0.00012$. $5/5$ seeds pass: the \emph {branch} credit is not an artefact of nonzero incidence. State shapes differ by the timing parameters (expected)}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Architecture-matched time-\emph  {input} controls on the zero-incidence Linear-$\Delta t$ backbone (XES3G5M fold~0, clean $L{=}400$, five training seeds). All three arms keep the extra Linear maps. T-real reuses the five Zero$+\Delta t$ checkpoints (not retrained). T-zero trains with all gaps set to $0$; T-misaligned permutes non-start gaps within each learner. The operating rule is $\Delta \mathrm  {val}\ge {+}0.002$ vs.\ T-real on every seed. Recovered T-real validation AUCs (Table~\ref {tab:qkc-zero-time}) give mean $\Delta \mathrm  {val}{+}0.00183$ vs.\ T-zero and $+0.00144$ vs.\ T-misaligned ($0/5$ either contrast). Test-only means: T-real $0.8295{\pm }0.0001$, T-zero $0.8275{\pm }0.0003$, T-misaligned $0.8280{\pm }0.0001$. Aligned $\Delta t$ is not isolated from the added branch under the pre-specified rule.}}{30}{table.9}\protected@file@percent }
\newlabel{tab:a1-timing}{{9}{30}{Architecture-matched time-\emph {input} controls on the zero-incidence Linear-$\Delta t$ backbone (XES3G5M fold~0, clean $L{=}400$, five training seeds). All three arms keep the extra Linear maps. T-real reuses the five Zero$+\Delta t$ checkpoints (not retrained). T-zero trains with all gaps set to $0$; T-misaligned permutes non-start gaps within each learner. The operating rule is $\Delta \mathrm {val}\ge {+}0.002$ vs.\ T-real on every seed. Recovered T-real validation AUCs (Table~\ref {tab:qkc-zero-time}) give mean $\Delta \mathrm {val}{+}0.00183$ vs.\ T-zero and $+0.00144$ vs.\^^MT-misaligned ($0/5$ either contrast). Test-only means: T-real $0.8295{\pm }0.0001$, T-zero $0.8275{\pm }0.0003$, T-misaligned $0.8280{\pm }0.0001$. Aligned $\Delta t$ is not isolated from the added branch under the pre-specified rule}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Leakage-audited knowledge attribution summary. The upper block is five paired training seeds on XES3G5M (or ASSIST2012 for teacher grouping) and is the credit map. The lower block is single-seed diagnostics and is \emph  {not} a five-seed credit test. ``Observed'' and ``zero'' refer only to the Q--KC incidence message; both retain the same question embedding and projection pathway. The operating rule is $\Delta \mathrm  {val}\ge {+}0.002$ versus the stated twin on every seed ($5/5$). Timing \emph  {branch} rows add maps as well as gap input; the aligned-input row keeps those maps and changes only the gap (Table~\ref {tab:a1-timing}).}}{31}{table.10}\protected@file@percent }
\newlabel{tab:attribution-summary}{{10}{31}{Leakage-audited knowledge attribution summary. The upper block is five paired training seeds on XES3G5M (or ASSIST2012 for teacher grouping) and is the credit map. The lower block is single-seed diagnostics and is \emph {not} a five-seed credit test. ``Observed'' and ``zero'' refer only to the Q--KC incidence message; both retain the same question embedding and projection pathway. The operating rule is $\Delta \mathrm {val}\ge {+}0.002$ versus the stated twin on every seed ($5/5$). Timing \emph {branch} rows add maps as well as gap input; the aligned-input row keeps those maps and changes only the gap (Table~\ref {tab:a1-timing})}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces QKC-T \emph  {test-only} AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$). Rows 0--2 are one checkpoint per learner fold (P0 split seeds); mean$\pm $SD is over folds, $n$ is native DH$^2$ test positions. Fold~0 here is the seed-42 checkpoint ($0.8296$); the five-seed test-only mean $0.8295{\pm }0.0001$ is Table~\ref {tab:auc-xes3g5m}. The archived A2 combined val+test mean $0.8296{\pm }0.0001$ ($n{=}1{,}640{,}242$) is \emph  {not} this column.}}{32}{table.11}\protected@file@percent }
\newlabel{tab:auc-p0-dt-folds}{{11}{32}{QKC-T \emph {test-only} AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$). Rows 0--2 are one checkpoint per learner fold (P0 split seeds); mean$\pm $SD is over folds, $n$ is native DH$^2$ test positions. Fold~0 here is the seed-42 checkpoint ($0.8296$); the five-seed test-only mean $0.8295{\pm }0.0001$ is Table~\ref {tab:auc-xes3g5m}. The archived A2 combined val+test mean $0.8296{\pm }0.0001$ ($n{=}1{,}640{,}242$) is \emph {not} this column}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Negative results under a pre-specified validation gate ($\Delta \mathrm  {val}\ge {+}0.002$ vs.\ a matched twin). ``Below gate'' means the form is not credited in the configuration we ran, not that the knowledge type is valueless. All runs keep a separate Linear/embedding branch (no absorption into \texttt  {concept\_embed}). Hypergraph convolution and hint-item hyperedges are among these diagnostics; they are not AUC novelty. M4 and P4 are five-seed means (seeds 42, 17, 1234, 0, 2024; $0/5$ seeds pass); K, L, M1, and M5 remain single-seed and are not five-seed credit tests. M5 is a 5{,}000-user Junyi subsample with path-derived \emph  {unordered} concept groups (Algorithm~1), not a directed-DAG test on the full corpus.}}{32}{table.12}\protected@file@percent }
\newlabel{tab:negative-knowledge}{{12}{32}{Negative results under a pre-specified validation gate ($\Delta \mathrm {val}\ge {+}0.002$ vs.\ a matched twin). ``Below gate'' means the form is not credited in the configuration we ran, not that the knowledge type is valueless. All runs keep a separate Linear/embedding branch (no absorption into \texttt {concept\_embed}). Hypergraph convolution and hint-item hyperedges are among these diagnostics; they are not AUC novelty. M4 and P4 are five-seed means (seeds 42, 17, 1234, 0, 2024; $0/5$ seeds pass); K, L, M1, and M5 remain single-seed and are not five-seed credit tests. M5 is a 5{,}000-user Junyi subsample with path-derived \emph {unordered} concept groups (Algorithm~1), not a directed-DAG test on the full corpus}{table.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Query-side vs.\ history-only Linear $\Delta t$ on XES3G5M fold~0 (clean $L{=}400$, five training seeds). Twin is Q$\leftarrow $KC without time-gap. Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$ (validation only; this column is the credit test). The AUC column is the same \emph  {test-only} metric as Table~\ref {tab:auc-xes3g5m} ($n{=}1{,}093{,}755$). \texttt  {both} is QKC-T (five seeds). Only \texttt  {both} meets the val gate on all five seeds. History-only is $2/5$ seeds pass and is not credited under the $5/5$ rule.}}{33}{table.13}\protected@file@percent }
\newlabel{tab:a7-query-dt}{{13}{33}{Query-side vs.\ history-only Linear $\Delta t$ on XES3G5M fold~0 (clean $L{=}400$, five training seeds). Twin is Q$\leftarrow $KC without time-gap. Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$ (validation only; this column is the credit test). The AUC column is the same \emph {test-only} metric as Table~\ref {tab:auc-xes3g5m} ($n{=}1{,}093{,}755$). \texttt {both} is QKC-T (five seeds). Only \texttt {both} meets the val gate on all five seeds. History-only is $2/5$ seeds pass and is not credited under the $5/5$ rule}{table.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Calibration on XES3G5M fold~0 test predictions under the clean protocol (mask-repeats, chunked, $L{=}400$). ECE uses 15 equal-width bins; lower is better. DH$^2$ checkpoints: seed~42 (QKC-T AUC $0.8296$ here matches Table~\ref {tab:auc-xes3g5m}; Zero$+\Delta t$ $0.8294$ is the same seed-42 checkpoint as Table~\ref {tab:qkc-zero-time}; the pathway-off twin $0.8202$ is calibration-only and is not a Table~\ref {tab:auc-xes3g5m} row), scored on native $n{=}1{,}093{,}755$ positions. pyKT GIKT/AKT/\textit  {simpleKT} use the same seed-42 prediction files as the headline intersection ($n{=}1{,}093{,}720$). An occurrence join on (user, dense-KC) matches $1{,}093{,}718$ rows; $36$ DH$^2$ rows and $2$ pyKT rows remain unmatched (\texttt  {b6\_id\_join\_summary.json}). We report calibration as a diagnostic and do not apply temperature scaling. Reliability curves (DH$^2$ arms, including Zero$+\Delta t$) appear in Figure~\ref {fig:reliability-xes3g5m}.}}{34}{table.14}\protected@file@percent }
\newlabel{tab:calibration-xes3g5m}{{14}{34}{Calibration on XES3G5M fold~0 test predictions under the clean protocol (mask-repeats, chunked, $L{=}400$). ECE uses 15 equal-width bins; lower is better. DH$^2$ checkpoints: seed~42 (QKC-T AUC $0.8296$ here matches Table~\ref {tab:auc-xes3g5m}; Zero$+\Delta t$ $0.8294$ is the same seed-42 checkpoint as Table~\ref {tab:qkc-zero-time}; the pathway-off twin $0.8202$ is calibration-only and is not a Table~\ref {tab:auc-xes3g5m} row), scored on native $n{=}1{,}093{,}755$ positions. pyKT GIKT/AKT/\textit {simpleKT} use the same seed-42 prediction files as the headline intersection ($n{=}1{,}093{,}720$). An occurrence join on (user, dense-KC) matches $1{,}093{,}718$ rows; $36$ DH$^2$ rows and $2$ pyKT rows remain unmatched (\texttt {b6\_id\_join\_summary.json}). We report calibration as a diagnostic and do not apply temperature scaling. Reliability curves (DH$^2$ arms, including Zero$+\Delta t$) appear in Figure~\ref {fig:reliability-xes3g5m}}{table.14}{}}
