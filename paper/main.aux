\@writefile{lot}{\contentsline {table}{\numberline {A.13}{\ignorespaces Manipulation check at node-drop $p{=}0.9$ on XES3G5M. DH$^2$-KT: train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). Training restores the best epoch by train loss (fold~1 previously collapsed on the final epoch). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite  {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined.}}{29}{table.13}\protected@file@percent }
\newlabel{tab:manipulation}{{A.13}{29}{Manipulation check at node-drop $p{=}0.9$ on XES3G5M. DH$^2$-KT: train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). Training restores the best epoch by train loss (fold~1 previously collapsed on the final epoch). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined}{table.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces Manipulation-check $\Delta $AUC on XES3G5M fold~0 under $p{=}0.9$ node-drop. An early pairwise$+$exercise-embedding backbone is graph-inert ($\Delta $AUC$\approx 0.0003$); the chain$+$graph-only redesign passes ($\Delta $AUC$=0.038$). The dashed line at $0.003$ is an \emph  {illustrative} floor ($\approx $10$\times $ the graph-inert noise), not a formal statistical cutoff from \cite  {daominh2026p0}.}}{30}{figure.2}\protected@file@percent }
\newlabel{fig:manipulation-sweep}{{A.2}{30}{Manipulation-check $\Delta $AUC on XES3G5M fold~0 under $p{=}0.9$ node-drop. An early pairwise$+$exercise-embedding backbone is graph-inert ($\Delta $AUC$\approx 0.0003$); the chain$+$graph-only redesign passes ($\Delta $AUC$=0.038$). The dashed line at $0.003$ is an \emph {illustrative} floor ($\approx $10$\times $ the graph-inert noise), not a formal statistical cutoff from \cite {daominh2026p0}}{figure.2}{}}
