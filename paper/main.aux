\@writefile{lot}{\contentsline {table}{\numberline {A.21}{\ignorespaces Diagnostic graph-only track (not QKC-T or Zero$+\Delta t$). Test AUC on XES3G5M under P0's matched GKT budget (batch 4, 10 epochs, max seq.\ len.\ 200; \emph  {not} the clean $L{=}400$ protocol of Table~\ref {tab:auc-xes3g5m}). DH$^2$-KT v2 uses path-derived concept-group chain hyperedges and graph-only interaction. Mean$\pm $SD over three learner folds. The P0 \textit  {simpleKT} column ($\approx 0.8747$) uses that older leaky protocol and is not comparable to the clean $0.8214{\pm }0.0007$ in Table~\ref {tab:auc-xes3g5m}.}}{45}{table.21}\protected@file@percent }
\newlabel{tab:auc-xes3g5m-v2}{{A.21}{45}{Diagnostic graph-only track (not QKC-T or Zero$+\Delta t$). Test AUC on XES3G5M under P0's matched GKT budget (batch 4, 10 epochs, max seq.\ len.\ 200; \emph {not} the clean $L{=}400$ protocol of Table~\ref {tab:auc-xes3g5m}). DH$^2$-KT v2 uses path-derived concept-group chain hyperedges and graph-only interaction. Mean$\pm $SD over three learner folds. The P0 \textit {simpleKT} column ($\approx 0.8747$) uses that older leaky protocol and is not comparable to the clean $0.8214{\pm }0.0007$ in Table~\ref {tab:auc-xes3g5m}}{table.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.22}{\ignorespaces Manipulation check on XES3G5M. Destruction is node-drop $p{=}0.9$, degree-preserving rewiring, and relation-label permutation on the graph-only diagnostic encoder (log label v2): train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). All three operators now share one clean AUC per fold (\texttt  {b9\_same\_ckpt\_destruction.json}; max $|\mathrm  {AUC}_{\mathrm  {local}}-\mathrm  {AUC}_{\mathrm  {shared}}|{=}2.0{\times }10^{-9}$). The older printed mismatch (fold~0 $0.753$ vs.\ $0.749$) was evaluator drift, not an operator effect. Node-drop confirms dependence on some graph input, not correct use of relation structure. Rewiring moves AUC on all three folds ($\Delta $AUC $0.0318$--$0.0351$); label permutation is near-null (expected for a single-kind encoder). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite  {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined. QKC-T and Zero$+\Delta t$ do not take this check.}}{46}{table.22}\protected@file@percent }
\newlabel{tab:manipulation}{{A.22}{46}{Manipulation check on XES3G5M. Destruction is node-drop $p{=}0.9$, degree-preserving rewiring, and relation-label permutation on the graph-only diagnostic encoder (log label v2): train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). All three operators now share one clean AUC per fold (\texttt {b9\_same\_ckpt\_destruction.json}; max $|\mathrm {AUC}_{\mathrm {local}}-\mathrm {AUC}_{\mathrm {shared}}|{=}2.0{\times }10^{-9}$). The older printed mismatch (fold~0 $0.753$ vs.\ $0.749$) was evaluator drift, not an operator effect. Node-drop confirms dependence on some graph input, not correct use of relation structure. Rewiring moves AUC on all three folds ($\Delta $AUC $0.0318$--$0.0351$); label permutation is near-null (expected for a single-kind encoder). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined. QKC-T and Zero$+\Delta t$ do not take this check}{table.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Manipulation-check $\Delta $AUC on XES3G5M fold~0 under $p{=}0.9$ node-drop. An early pairwise$+$exercise-embedding backbone is graph-inert ($\Delta $AUC$\approx 0.0003$); the chain$+$graph-only redesign moves ($\Delta $AUC$=0.038$). The dashed line at $0.003$ is an \emph  {illustrative} floor ($\approx $10$\times $ the graph-inert noise), not a formal statistical cutoff from \cite  {daominh2026p0}.}}{47}{figure.3}\protected@file@percent }
\newlabel{fig:manipulation-sweep}{{A.3}{47}{Manipulation-check $\Delta $AUC on XES3G5M fold~0 under $p{=}0.9$ node-drop. An early pairwise$+$exercise-embedding backbone is graph-inert ($\Delta $AUC$\approx 0.0003$); the chain$+$graph-only redesign moves ($\Delta $AUC$=0.038$). The dashed line at $0.003$ is an \emph {illustrative} floor ($\approx $10$\times $ the graph-inert noise), not a formal statistical cutoff from \cite {daominh2026p0}}{figure.3}{}}
