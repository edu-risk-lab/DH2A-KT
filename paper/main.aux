\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Test-only AUC on XES3G5M fold~0 under the \emph  {clean} protocol: mask-repeats, chunked windows, max seq.\ len.\ 400. DH$^2$-KT uses a v4 LSTM with question embeddings; Q$\leftarrow $KC is bipartite incidence (\texttt  {--question-graph}), not hypergraph convolution; $+\Delta t$ is a Linear $\log (1{+}\mathrm  {gap})$ branch into LSTM and next-step query (\texttt  {--time-gap}, both). GIKT is matched to the DH$^2$ budget (batch 16, cap 30 epochs, patience 5; early-stop epoch 8). AKT keeps P0 hyperparameters at $L{=}400$. Learner-level bootstrap: Q$\leftarrow $KC$+\Delta t$ minus AKT is $+0.00745$, 95\% CI $[+0.00703,+0.00792]$. This is \emph  {not} the three-fold graph-only v2 table (Appendix~\ref {app:graph-only}).}}{17}{table.4}\protected@file@percent }
\newlabel{tab:auc-xes3g5m}{{4}{17}{Test-only AUC on XES3G5M fold~0 under the \emph {clean} protocol: mask-repeats, chunked windows, max seq.\ len.\ 400. DH$^2$-KT uses a v4 LSTM with question embeddings; Q$\leftarrow $KC is bipartite incidence (\texttt {--question-graph}), not hypergraph convolution; $+\Delta t$ is a Linear $\log (1{+}\mathrm {gap})$ branch into LSTM and next-step query (\texttt {--time-gap}, both). GIKT is matched to the DH$^2$ budget (batch 16, cap 30 epochs, patience 5; early-stop epoch 8). AKT keeps P0 hyperparameters at $L{=}400$. Learner-level bootstrap: Q$\leftarrow $KC$+\Delta t$ minus AKT is $+0.00745$, 95\% CI $[+0.00703,+0.00792]$. This is \emph {not} the three-fold graph-only v2 table (Appendix~\ref {app:graph-only})}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Q$\leftarrow $KC$+\Delta t$ test-only AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$), one model per learner fold. Folds are P0's three split seeds. Mean$\pm $SD is over folds, not over bootstrap resamples of fold~0.}}{17}{table.5}\protected@file@percent }
\newlabel{tab:auc-p0-dt-folds}{{5}{17}{Q$\leftarrow $KC$+\Delta t$ test-only AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$), one model per learner fold. Folds are P0's three split seeds. Mean$\pm $SD is over folds, not over bootstrap resamples of fold~0}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Negative results under a pre-registered validation gate ($\Delta \mathrm  {val}\ge {+}0.002$ vs.\ a matched twin). All runs keep a separate Linear/embedding branch (no absorption into \texttt  {concept\_embed}). FAIL means the knowledge type is \emph  {not} credited as predictive. Hypergraph convolution and hint-item hyperedges are among the failures; they are not AUC novelty.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:negative-knowledge}{{6}{18}{Negative results under a pre-registered validation gate ($\Delta \mathrm {val}\ge {+}0.002$ vs.\ a matched twin). All runs keep a separate Linear/embedding branch (no absorption into \texttt {concept\_embed}). FAIL means the knowledge type is \emph {not} credited as predictive. Hypergraph convolution and hint-item hyperedges are among the failures; they are not AUC novelty}{table.6}{}}
