\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Test AUC on XES3G5M under matched training budget (batch 4, 10 epochs, max seq.\ len.\ 200). P0 fold AUCs from \texttt  {baselines/p0\_reused} (train-only graphs); DH$^2$-KT v2 uses chain concept-prerequisite hyperedges and graph-only interaction. Mean$\pm $SD over three learner folds.}}{33}{table.4}\protected@file@percent }
\newlabel{tab:auc-xes3g5m}{{4}{33}{Test AUC on XES3G5M under matched training budget (batch 4, 10 epochs, max seq.\ len.\ 200). P0 fold AUCs from \texttt {baselines/p0\_reused} (train-only graphs); DH$^2$-KT v2 uses chain concept-prerequisite hyperedges and graph-only interaction. Mean$\pm $SD over three learner folds}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Manipulation check at node-drop $p{=}0.9$ on XES3G5M. DH$^2$-KT: train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). Training restores the best epoch by train loss (fold~1 previously collapsed on the final epoch). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite  {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined.}}{33}{table.5}\protected@file@percent }
\newlabel{tab:manipulation}{{5}{33}{Manipulation check at node-drop $p{=}0.9$ on XES3G5M. DH$^2$-KT: train on clean hyperedges, re-evaluate frozen weights on destroyed hyperedges (folds~0--2). Training restores the best epoch by train loss (fold~1 previously collapsed on the final epoch). GKT: P0 DDR-downstream mean $\Delta $AUC over $n{=}9$ fold--seed runs (\cite {daominh2026p0}; retrain on destroyed pairwise graph). simpleKT has no concept-graph input, so graph destruction is undefined}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Paired ablation of DH$^2$A-KT components. Tier~1 metrics are on XES3G5M unless noted; Tier~2 faithfulness uses the fold~0 frozen checkpoint and Qwen2.5-7B (Ollama, $n{=}500$) unless noted. ``w/o Critic'' disables the gate on the same grounded Diagnostician outputs (flag rate $0$ by construction; JC unchanged). Independent generation (IG) strips frozen $P(\mathrm  {correct})$ from the Diagnostician. Session hyperedges are FoundationalASSIST-only. ``w/o $L_{\mathrm  {aux}}$'' sets \texttt  {graph\_sensitivity\_weight}${}=0$ (fold~0 retrain).}}{34}{table.6}\protected@file@percent }
\newlabel{tab:paired-ablation}{{6}{34}{Paired ablation of DH$^2$A-KT components. Tier~1 metrics are on XES3G5M unless noted; Tier~2 faithfulness uses the fold~0 frozen checkpoint and Qwen2.5-7B (Ollama, $n{=}500$) unless noted. ``w/o Critic'' disables the gate on the same grounded Diagnostician outputs (flag rate $0$ by construction; JC unchanged). Independent generation (IG) strips frozen $P(\mathrm {correct})$ from the Diagnostician. Session hyperedges are FoundationalASSIST-only. ``w/o $L_{\mathrm {aux}}$'' sets \texttt {graph\_sensitivity\_weight}${}=0$ (fold~0 retrain)}{table.6}{}}
