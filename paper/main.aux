\newlabel{tab:human-eval}{{9}{35}{Human rating of Tier~2 outputs (XES3G5M fold~0 Ollama v2 pilot subsample, $n{=}40$ explanations, 2 independent raters, Likert 1--5). Agreement is pairwise Spearman $\rho $ and fraction of scores within $\pm 1$}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces FoundationalASSIST secondary corpus (fold~0). Session hyperedges use a 30-minute gap; Hint members appear when \texttt  {hint\_count}$>0$. Predictive AUC is observational (no P0-reused GKT/simpleKT column). Hint ATE is IPW of \texttt  {hint\_used}$_t$ on \texttt  {correct}$_{t+1}$ under pre-$t$ confounders; propensity mass hits the clip floor --- treat as limited observational evidence.}}{36}{table.10}\protected@file@percent }
\newlabel{tab:foundational-assist}{{10}{36}{FoundationalASSIST secondary corpus (fold~0). Session hyperedges use a 30-minute gap; Hint members appear when \texttt {hint\_count}$>0$. Predictive AUC is observational (no P0-reused GKT/simpleKT column). Hint ATE is IPW of \texttt {hint\_used}$_t$ on \texttt {correct}$_{t+1}$ under pre-$t$ confounders; propensity mass hits the clip floor --- treat as limited observational evidence}{table.10}{}}
