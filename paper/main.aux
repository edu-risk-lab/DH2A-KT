\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Test-only AUC on XES3G5M fold~0 under the \emph  {clean} protocol: mask-repeats, chunked windows, max seq.\ len.\ 400. All models are scored on an identical set of $1{,}093{,}720$ target positions. DH$^2$-KT and pyKT rows marked with $\pm $ report mean$\pm $SD over five training seeds (42, 17, 1234, 0, 2024; A2 matrix); others are single-seed fold~0 runs. DH$^2$-KT uses a v4 LSTM with question embeddings; Q$\leftarrow $KC is bipartite incidence (\texttt  {--question-graph}), not hypergraph convolution; $+\Delta t$ is Linear $\log (1{+}\mathrm  {gap})$ into LSTM and next-step query (\texttt  {--time-gap}, both). The pathway-off twin removes the question pathway (capacity-mismatched); the capacity-matched zero-incidence check is Table~\ref {tab:qkc-capacity} and fails the gate. The history-only row is \texttt  {--time-gap-mode lstm} (observed gaps only, no query-side wait), seed~42 (Table~\ref {tab:a7-query-dt}); it fails the $\Delta \mathrm  {val}$ gate. pyKT \cite  {liu2022pykt} baselines are retrained under the same export and masking rules; P0 published numbers use a different (leaky) protocol and are not comparable. GIKT is matched to the DH$^2$ \emph  {compute} envelope (batch 16, cap 30 epochs, patience 5), not to a hyperparameter search (Appendix~\ref {app:hparams}). Five-seed mean gaps on this table are $+0.0038$ vs.\ GIKT, $+0.0074$ vs.\ AKT, and $+0.0082$ vs.\ \textit  {simpleKT}. Paired learner-level bootstrap CIs on one canonical fold-0 file (not those mean gaps) exclude $0$ (Section~\ref {sec:time-result}). DyGKT at $L{=}400$ failed to converge (valid AUC ${\approx }0.60$); a clean rerun at $L{=}200$ reached $0.6756$ and is omitted here. This is \emph  {not} the three-fold graph-only v2 table (Appendix~\ref {app:graph-only}).}}{25}{table.4}\protected@file@percent }
\newlabel{tab:auc-xes3g5m}{{4}{25}{Test-only AUC on XES3G5M fold~0 under the \emph {clean} protocol: mask-repeats, chunked windows, max seq.\ len.\ 400. All models are scored on an identical set of $1{,}093{,}720$ target positions. DH$^2$-KT and pyKT rows marked with $\pm $ report mean$\pm $SD over five training seeds (42, 17, 1234, 0, 2024; A2 matrix); others are single-seed fold~0 runs. DH$^2$-KT uses a v4 LSTM with question embeddings; Q$\leftarrow $KC is bipartite incidence (\texttt {--question-graph}), not hypergraph convolution; $+\Delta t$ is Linear $\log (1{+}\mathrm {gap})$ into LSTM and next-step query (\texttt {--time-gap}, both). The pathway-off twin removes the question pathway (capacity-mismatched); the capacity-matched zero-incidence check is Table~\ref {tab:qkc-capacity} and fails the gate. The history-only row is \texttt {--time-gap-mode lstm} (observed gaps only, no query-side wait), seed~42 (Table~\ref {tab:a7-query-dt}); it fails the $\Delta \mathrm {val}$ gate. pyKT \cite {liu2022pykt} baselines are retrained under the same export and masking rules; P0 published numbers use a different (leaky) protocol and are not comparable. GIKT is matched to the DH$^2$ \emph {compute} envelope (batch 16, cap 30 epochs, patience 5), not to a hyperparameter search (Appendix~\ref {app:hparams}). Five-seed mean gaps on this table are $+0.0038$ vs.\ GIKT, $+0.0074$ vs.\ AKT, and $+0.0082$ vs.\^^M\textit {simpleKT}. Paired learner-level bootstrap CIs on one canonical fold-0 file (not those mean gaps) exclude $0$ (Section~\ref {sec:time-result}). DyGKT at $L{=}400$ failed to converge (valid AUC ${\approx }0.60$); a clean rerun at $L{=}200$ reached $0.6756$ and is omitted here. This is \emph {not} the three-fold graph-only v2 table (Appendix~\ref {app:graph-only})}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Capacity-matched Q$\leftarrow $KC attribution on XES3G5M fold~0 (clean protocol). Both arms keep \texttt  {--question-graph} (same \texttt  {question\_embed}, GCN linear, and input projection); only the train-only incidence matrix is replaced by zeros in the twin (\texttt  {--question-incidence-control zero}). Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$. Checkpoint state shapes match on every seed; observed nonzero links $=8848$, zero arm $=0$. Mean $\Delta \mathrm  {val}{=}{-}0.00010{\pm }0.00034$; mean $\Delta \mathrm  {test\text  {-}only}{\approx }{+}0.00004$. $0/5$ PASS: the incidence \emph  {message} is not credited. The older hard-off twin that removed the whole question pathway is not used for this claim (Section~\ref {sec:credit-gate}). $\Delta $test columns are outer test-only AUC (1{,}093{,}755 scored positions).}}{26}{table.5}\protected@file@percent }
\newlabel{tab:qkc-capacity}{{5}{26}{Capacity-matched Q$\leftarrow $KC attribution on XES3G5M fold~0 (clean protocol). Both arms keep \texttt {--question-graph} (same \texttt {question\_embed}, GCN linear, and input projection); only the train-only incidence matrix is replaced by zeros in the twin (\texttt {--question-incidence-control zero}). Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$. Checkpoint state shapes match on every seed; observed nonzero links $=8848$, zero arm $=0$. Mean $\Delta \mathrm {val}{=}{-}0.00010{\pm }0.00034$; mean $\Delta \mathrm {test\text {-}only}{\approx }{+}0.00004$. $0/5$ PASS: the incidence \emph {message} is not credited. The older hard-off twin that removed the whole question pathway is not used for this claim (Section~\ref {sec:credit-gate}). $\Delta $test columns are outer test-only AUC (1{,}093{,}755 scored positions)}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Linear $\Delta t$ on the capacity-matched \emph  {zero-incidence} backbone (XES3G5M fold~0, clean protocol). Both arms keep zero Q--KC incidence; \texttt  {zero\_time} adds LSTM+query $\log (1{+}\Delta t)$ (\texttt  {--time-gap-mode both}). Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$. Mean $\Delta \mathrm  {val}{=}{+}0.00255{\pm }0.00015$; mean $\Delta \mathrm  {test\text  {-}only}{=}{+}0.00269{\pm }0.00012$. $5/5$ PASS: timing credit is not an artefact of nonzero incidence. State shapes differ by the timing parameters (expected).}}{26}{table.6}\protected@file@percent }
\newlabel{tab:qkc-zero-time}{{6}{26}{Linear $\Delta t$ on the capacity-matched \emph {zero-incidence} backbone (XES3G5M fold~0, clean protocol). Both arms keep zero Q--KC incidence; \texttt {zero\_time} adds LSTM+query $\log (1{+}\Delta t)$ (\texttt {--time-gap-mode both}). Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$. Mean $\Delta \mathrm {val}{=}{+}0.00255{\pm }0.00015$; mean $\Delta \mathrm {test\text {-}only}{=}{+}0.00269{\pm }0.00012$. $5/5$ PASS: timing credit is not an artefact of nonzero incidence. State shapes differ by the timing parameters (expected)}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Q$\leftarrow $KC$+\Delta t$ test-only AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$). \textbf  {Rows 0--2:} one model per learner fold (P0's three split seeds); mean$\pm $SD is over folds. \textbf  {Bottom row:} training-seed stability on fold~0 ($n{=}5$ seeds: 42, 17, 1234, 0, 2024; A2 matrix); mean$\pm $SD is over seeds.}}{27}{table.7}\protected@file@percent }
\newlabel{tab:auc-p0-dt-folds}{{7}{27}{Q$\leftarrow $KC$+\Delta t$ test-only AUC on XES3G5M under the clean protocol (mask-repeats, chunked, $L{=}400$). \textbf {Rows 0--2:} one model per learner fold (P0's three split seeds); mean$\pm $SD is over folds. \textbf {Bottom row:} training-seed stability on fold~0 ($n{=}5$ seeds: 42, 17, 1234, 0, 2024; A2 matrix); mean$\pm $SD is over seeds}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Negative results under a pre-registered validation gate ($\Delta \mathrm  {val}\ge {+}0.002$ vs.\ a matched twin). All runs keep a separate Linear/embedding branch (no absorption into \texttt  {concept\_embed}). FAIL means the knowledge type is \emph  {not} credited as predictive. Hypergraph convolution and hint-item hyperedges are among the failures; they are not AUC novelty.}}{27}{table.8}\protected@file@percent }
\newlabel{tab:negative-knowledge}{{8}{27}{Negative results under a pre-registered validation gate ($\Delta \mathrm {val}\ge {+}0.002$ vs.\ a matched twin). All runs keep a separate Linear/embedding branch (no absorption into \texttt {concept\_embed}). FAIL means the knowledge type is \emph {not} credited as predictive. Hypergraph convolution and hint-item hyperedges are among the failures; they are not AUC novelty}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Query-side vs.\ history-only Linear $\Delta t$ on XES3G5M fold~0 (clean $L{=}400$, seed~42). Twin is Q$\leftarrow $KC without time-gap (val AUC $0.82598$). Pre-specified gate: $\Delta \mathrm  {val}\ge {+}0.002$. \texttt  {lstm} is the history-only arm (observed gaps only). Only \texttt  {both} passes; the credited both-mode timing is not available under a history-only deployment.}}{28}{table.9}\protected@file@percent }
\newlabel{tab:a7-query-dt}{{9}{28}{Query-side vs.\ history-only Linear $\Delta t$ on XES3G5M fold~0 (clean $L{=}400$, seed~42). Twin is Q$\leftarrow $KC without time-gap (val AUC $0.82598$). Pre-specified gate: $\Delta \mathrm {val}\ge {+}0.002$. \texttt {lstm} is the history-only arm (observed gaps only). Only \texttt {both} passes; the credited both-mode timing is not available under a history-only deployment}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Calibration on XES3G5M fold~0 test predictions under the clean protocol (mask-repeats, chunked, $L{=}400$). ECE uses 15 equal-width bins; lower is better. Checkpoints: seed~42 A2 matrix (twin AUC $0.8202$ here; Table~\ref {tab:auc-xes3g5m} reports the five-seed mean $0.8206{\pm }0.0002$). Native DH$^2$ scoring yields $n{=}1{,}093{,}755$ positions; the headline AUC table uses the pyKT-aligned intersection $n{=}1{,}093{,}720$ (difference of 35). Reliability curves appear in Figure~\ref {fig:reliability-xes3g5m}.}}{28}{table.10}\protected@file@percent }
\newlabel{tab:calibration-xes3g5m}{{10}{28}{Calibration on XES3G5M fold~0 test predictions under the clean protocol (mask-repeats, chunked, $L{=}400$). ECE uses 15 equal-width bins; lower is better. Checkpoints: seed~42 A2 matrix (twin AUC $0.8202$ here; Table~\ref {tab:auc-xes3g5m} reports the five-seed mean $0.8206{\pm }0.0002$). Native DH$^2$ scoring yields $n{=}1{,}093{,}755$ positions; the headline AUC table uses the pyKT-aligned intersection $n{=}1{,}093{,}720$ (difference of 35). Reliability curves appear in Figure~\ref {fig:reliability-xes3g5m}}{table.10}{}}
